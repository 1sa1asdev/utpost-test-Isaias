{
  "name": "utpost",
  "private": true,
  "version": "1.4.2",
  "workspaces": [
    "shared",
    "api",
    "web",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace=api\" \"npm run dev --workspace=web\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "seed": "npm run seed --workspace=api",
    "dev:client": "npm run dev --workspace=client",
    "lint": "npm run lint --workspace=client",
    "typecheck": "npm run codegen --workspace=client && npm run typecheck --workspace=client && npm run typecheck --workspace=api",
    "format:check": "npm run format:check --workspace=client",
    "test": "npm run test --workspace=client",
    "build": "npm run build --workspace=client",
    "mongo:smoke": "npm run mongo:smoke --workspace=api",
    "migrate:logs": "npm run migrate:logs --workspace=api",
    "codegen": "npm run codegen --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
